privatenexus.net {
    log
    import crowdsec
    import compress
    # PERMANENT (decided 2026-07-24): PrivateNexus's home is hot-pn (formerly
    # pn-vps, Hostkey CH, 151.241.217.140) over the wg3 tunnel, deliberately
    # kept off bare metal so a future Proxmox/bare-metal outage can't take it
    # down too -- see hostkey_server_replacement memory. Not a revert target.
    # /api/* gets a much longer response timeout than Caddy's default -- found 2026-08-10 via a
    # real Catalogue deploy (Notesnook, 7 health-checked containers) genuinely taking several
    # minutes server-side while Caddy 504'd the client at ~60s. The backend kept processing
    # correctly regardless (confirmed via direct DB/container polling both times this hit), but a
    # real user clicking Approve in the browser would see a false-looking timeout/error. Scoped to
    # /api/* only, not the whole site, so static frontend asset requests keep the tight default.
    @api path /api/*
    reverse_proxy @api 10.10.2.2:5173 {
        transport http {
            response_header_timeout 10m
        }
    }
    reverse_proxy 10.10.2.2:5173
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
docs.privatenexus.net {
    log
    import crowdsec
    import compress
    # PrivateNexus product documentation (Wiki.js), deployed 2026-08-25 -- lives on hot-pn over
    # wg3, same reverse-proxy-to-tunnel-IP pattern as privatenexus.net above. No `import sso`
    # deliberately -- this is customer-facing product documentation, meant to be publicly
    # readable without any HoT/PN staff login (same documented exception as cloud.house-of-trae.com
    # below, New Service Deployment Checklist item 13). Editor/admin access is gated separately,
    # inside Wiki.js itself, via native OIDC against the privatenexus Keycloak realm -- public
    # read, authenticated write, not a site-wide login wall.
    reverse_proxy 10.10.2.2:3080
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
cloud.house-of-trae.com {
    log
    import crowdsec
    import compress
    # No `import sso` here deliberately -- WebDAV/CalDAV/CardDAV device sync clients (phone/desktop
    # Nextcloud apps) hit this domain directly with app passwords/Basic auth, not a browser, so they
    # can't complete oauth2-proxy's interactive redirect flow. Nextcloud's own login + 2FA is the
    # auth boundary here instead, matching the documented exception (New Service Deployment
    # Checklist item 13) for services that can't sensibly support a browser login gate.
    # Deployed via the PrivateNexus Catalogue deploy flow (Phase 1), lives on hot-pn over wg3 --
    # same reverse-proxy-to-tunnel-IP pattern as the privatenexus.net block above.
    reverse_proxy 10.10.2.2:28142
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
# Notesnook self-hosted backend (Catalogue deploy Phase 2, 2026-08-10) -- 4 of its 5 services wired
# here 2026-08-11. Same as cloud.house-of-trae.com above: native app clients (auth/sync/SSE
# protocol, not a browser), so no `import sso` -- Notesnook's own account auth is the boundary.
# notes-pub (monograph, public note-sharing links) deliberately NOT wired -- that image binds its
# listener to [::1] (IPv6 loopback) only, confirmed unreachable even from another container on the
# same docker network, so a plain port-publish can't reach it; would need a network-namespace-
# sharing sidecar proxy to fix. Optional feature, skipped unless actually needed.
notes-auth.house-of-trae.com {
    log
    import crowdsec
    import compress
    reverse_proxy 10.10.2.2:8264
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
